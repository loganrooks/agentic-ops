# Autonomous-execution runtime state. These files are written by the agent
# during plan execution and tracked locally only. The final P9 archive phase
# uses `git add -f` to commit a frozen snapshot to the archive directory.
.planning/auto-execution/

# OS / editor noise
.DS_Store
*~
.vscode/
.idea/

# Claude Code personal-state. Skills under .claude/skills/ ARE committed
# (they're the supervisor-side companion for escalation-watch); local
# settings overrides and per-user worktree state are not.
.claude/settings.local.json
.claude/worktrees/

# BEGIN agentic-mail
.mail/claude/inbox/
.mail/claude/processed/
.mail/claude/archive/**/*.md
!.mail/claude/archive/.gitkeep
.mail/codex/inbox/
.mail/codex/processed/
.mail/codex/archive/**/*.md
!.mail/codex/archive/.gitkeep
.mail/human/inbox/
.mail/human/processed/
.mail/human/archive/**/*.md
!.mail/human/archive/.gitkeep
.mail/attachments/
.mail/.audit.jsonl
.mail/.budget.json
# END agentic-mail
